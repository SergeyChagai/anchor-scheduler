{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anchor-scheduler",
  "version": "0.0.1",
  "identifier": "dev.chagai.anchor-scheduler",
  "build": {
    "beforeDevCommand": "pnpm --filter @anchor-scheduler/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @anchor-scheduler/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "anchor-scheduler",
        "width": 1040,
        "height": 840,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Anchors and time-blocked tasks.",
    "longDescription": "Local-first day scheduler: a few non-negotiable anchors hold the day together, and TODO tasks are time-blocked into the focus containers between them.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
